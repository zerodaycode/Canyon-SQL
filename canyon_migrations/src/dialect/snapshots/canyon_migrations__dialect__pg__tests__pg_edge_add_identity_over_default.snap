---
source: canyon_migrations/src/dialect/pg.rs
expression: "render::<PgDialect>(&op, &actual, \"public\")"
---
ALTER TABLE "player" ALTER COLUMN "id" DROP DEFAULT
  params: []
  transactional: true
ALTER TABLE "player" ALTER COLUMN "id" ADD GENERATED ALWAYS AS IDENTITY
  params: []
  transactional: true
SELECT setval(d.objid::regclass, COALESCE((SELECT MAX("id") FROM "player"), 0) + 1, false) FROM pg_depend d JOIN pg_attribute a ON a.attrelid = d.refobjid AND a.attnum = d.refobjsubid WHERE d.classid = 'pg_class'::regclass AND d.refobjid = $1::text::regclass AND a.attname::text = $2::text AND d.deptype = 'i'
  params: [Text("\"player\""), Text("id")]
  transactional: true
